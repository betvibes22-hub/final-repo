# ═══════════════════════════════════════════════════════════════
# THE FREE STACK THIS APP USES — every key below is free, no card
# ═══════════════════════════════════════════════════════════════

# ── Script generation (LLM) ──────────────────────────────────────
# Groq: free, no card. console.groq.com/keys
GROQ_API_KEY=

# ── Trend research (optional) ────────────────────────────────────
# Tavily: free, recurring — 1,000 credits/month, no card. tavily.com
TAVILY_API_KEY=

# ── Voiceover (text-to-speech) ───────────────────────────────────
# VoiceRSS: free, no card — 350 requests/day. voicerss.org/registration.aspx
VOICERSS_API_KEY=

# ── Visuals (matching photos) ────────────────────────────────────
# Pexels: free, no card. pexels.com/api/new
PEXELS_API_KEY=

# ── Video storage + library (Cloudinary) ─────────────────────────
# Free, no card, 25 credits/month. cloudinary.com — find these three
# values on your dashboard home page after signing up.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
